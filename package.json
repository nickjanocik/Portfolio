{
  "name": "nick-janocik-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "A single-page responsive portfolio site for Nick Janocik.",
  "scripts": {
    "dev": "npm run build:workwithme && python3 -m http.server 5173 --bind 127.0.0.1",
    "build": "npm run build:workwithme && node scripts/build.mjs",
    "dev:workwithme": "vite --config workwithme-src/vite.config.ts --host 127.0.0.1",
    "build:workwithme": "tsc --noEmit -p workwithme-src/tsconfig.json && vite build --config workwithme-src/vite.config.ts",
    "check": "tsc --noEmit -p workwithme-src/tsconfig.json",
    "test:workwithme": "node scripts/verify-workwithme.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "lucide-react": "^0.468.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/node": "^22.18.6",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "tailwindcss": "^4.1.13",
    "@tailwindcss/vite": "^4.1.13",
    "esbuild": "^0.28.2"
  }
}
