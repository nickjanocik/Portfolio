# Public booking event URL. Create a 20-minute event at calendly.com using
# nickjanocik@gmail.com, then paste its real link here in .env.local.
# Keep blank until the account/event exists; visitors get the real email flow.
VITE_CALENDLY_URL=

# Optional real Formspree endpoint. Without this, the form opens an email draft
# and never claims the message was sent. The receiving email must be verified.
VITE_FORMSPREE_ENDPOINT=
